---
import type { Locale } from "@handyweb/core";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const text = {
    fa: {
        button: "جستجو",
        label: "جستجوی ابزارها",
        placeholder: "نام ابزار، مثلا Base64 یا تاریخ",
        empty: "ابزاری پیدا نشد.",
        hint: "Enter بهترین نتیجه را باز می‌کند. با کلید جهت پایین به فهرست نتیجه‌ها بروید. Esc می‌بندد.",
        shortcut: "/",
    },
    en: {
        button: "Search",
        label: "Search the tools",
        placeholder: "Tool name, for example Base64 or date",
        empty: "No tool found.",
        hint: "Enter opens the best result. Press the down arrow to move through the results. Esc closes.",
        shortcut: "/",
    },
}[locale];
---

<button
    type="button"
    data-search-open
    class="inline-flex min-w-36 items-center gap-2 rounded-md border border-border bg-surface px-2.5 py-1.5 text-sm text-muted hover:bg-surface-2"
>
    <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
    >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
    </svg>
    <span>{text.button}</span>
    <kbd class="ms-auto rounded border border-border px-1.5 text-xs">{text.shortcut}</kbd>
</button>

<dialog
    data-search-dialog
    aria-label={text.label}
    class="m-auto mt-[10vh] w-[min(40rem,calc(100vw-2rem))] rounded-xl border border-border bg-surface p-0 text-text shadow-xl backdrop:bg-black/50"
>
    <div class="flex flex-col gap-2 p-3">
        <input
            type="search"
            data-search-input
            aria-controls="search-results"
            aria-label={text.label}
            aria-describedby="search-hint"
            placeholder={text.placeholder}
            autocomplete="off"
            class="min-h-11 w-full rounded-md border border-border bg-bg px-3 text-base"
        />
        <p id="search-hint" class="sr-only">
            {text.hint}
        </p>
        <ul
            id="search-results"
            aria-label={text.label}
            data-search-results
            class="max-h-[60vh] overflow-y-auto"
        ></ul>
        <p
            role="status"
            data-search-status
            data-empty={text.empty}
            class="px-3 text-sm text-muted"
        ></p>
    </div>
</dialog>

<script>
    import "../scripts/search";
</script>

---
import type { Locale } from "@handyweb/core";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const text = {
    fa: {
        button: "جستجو",
        label: "جستجوی ابزارها",
        placeholder: "نام ابزار، برای نمونه Base64 یا تاریخ",
        empty: "ابزاری پیدا نشد.",
        hint: "Enter نخستین یافته را باز می‌کند. با کلید پیکان پایین میان یافته‌ها بروید. Esc پنجره را می‌بندد.",
        shortcut: "/",
    },
    en: {
        button: "Search",
        label: "Search the tools",
        placeholder: "Tool name, for example Base64 or date",
        empty: "No tool found.",
        hint: "Enter opens the best result. Press the down arrow to move through the results. Esc closes.",
        shortcut: "/",
    },
}[locale];
---

<dialog
    data-search-dialog
    aria-label={text.label}
    class="m-auto mt-[8vh] w-[min(40rem,calc(100vw-2rem))] rounded-2xl border border-border bg-surface p-0 text-text backdrop:bg-black/40 backdrop:backdrop-blur-sm"
>
    <div class="flex flex-col gap-2 p-3">
        <input
            type="search"
            data-search-input
            aria-controls="search-results"
            aria-label={text.label}
            aria-describedby="search-hint"
            placeholder={text.placeholder}
            autocomplete="off"
            class="min-h-12 w-full rounded-xl bg-surface-2 px-4 text-lg outline-none placeholder:text-muted focus-visible:outline-2 focus-visible:outline-focus"
        />
        <p id="search-hint" class="sr-only">
            {text.hint}
        </p>
        <ul
            id="search-results"
            aria-label={text.label}
            data-search-results
            class="max-h-[60vh] overflow-y-auto"
        ></ul>
        <p
            role="status"
            data-search-status
            data-empty={text.empty}
            class="px-3 text-sm text-muted"
        ></p>
    </div>
</dialog>

<script>
    import "../scripts/search";
</script>

---
/*
 * Cycles the theme: system, light, dark. The choice is the one allowed
 * preference key `handyweb:theme` (D5).
 */
import type { Locale } from "@handyweb/core";
import { useTranslations } from "../i18n/site";

interface Props {
    locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const labels = {
    system: t("theme.system"),
    light: t("theme.light"),
    dark: t("theme.dark"),
};
---

<button
    type="button"
    data-theme-toggle
    data-labels={JSON.stringify(labels)}
    title={t("theme.button")}
    class="inline-flex items-center gap-1.5 rounded-md border border-border bg-surface px-2.5 py-1.5 text-sm hover:bg-surface-2"
>
    <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
    >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path>
    </svg>
    <span>{t("theme.label")}:</span>
    <span data-theme-label>{labels.system}</span>
</button>

<script>
    const KEY = "handyweb:theme";
    const ORDER = ["system", "light", "dark"] as const;
    type Choice = (typeof ORDER)[number];

    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const root = document.documentElement;

    function read(): Choice {
        try {
            const value = localStorage.getItem(KEY);
            return value === "light" || value === "dark" ? value : "system";
        } catch {
            return "system";
        }
    }

    function write(choice: Choice): void {
        try {
            if (choice === "system") localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, choice);
        } catch {
            // Storage is blocked. The choice lasts until the next page load.
        }
    }

    function apply(choice: Choice): void {
        const dark = choice === "dark" || (choice === "system" && media.matches);
        root.dataset.theme = dark ? "dark" : "light";
        root.dataset.themeChoice = choice;
        for (const button of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
            const labels = JSON.parse(button.dataset.labels ?? "{}") as Record<Choice, string>;
            const label = button.querySelector("[data-theme-label]");
            if (label) label.textContent = labels[choice] ?? choice;
        }
    }

    let current: Choice = (root.dataset.themeChoice as Choice | undefined) ?? read();
    apply(current);

    media.addEventListener("change", () => {
        if (current === "system") apply(current);
    });

    for (const button of document.querySelectorAll("[data-theme-toggle]")) {
        button.addEventListener("click", () => {
            current = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length] ?? "system";
            write(current);
            apply(current);
        });
    }
</script>

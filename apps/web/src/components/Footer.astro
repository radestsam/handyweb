---
import { localePath, type Locale } from "@handyweb/core";
import { useTranslations } from "../i18n/site";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const links = [
    { href: localePath(locale, "/about"), label: t("nav.about") },
    { href: localePath(locale, "/privacy"), label: t("nav.privacy") },
    { href: localePath(locale, "/opensource"), label: t("nav.opensource") },
    { href: localePath(locale, "/contribute"), label: t("nav.contribute") },
];
---

<footer class="mt-16 border-t border-border bg-surface">
    <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 text-sm">
        <nav aria-label={t("nav.footer")}>
            <ul class="flex flex-wrap gap-x-4 gap-y-2">
                {links.map((link) => (
                    <li>
                        <a href={link.href}>{link.label}</a>
                    </li>
                ))}
                <li>
                    <a href="https://github.com/radestsam/handyweb" rel="noopener">
                        {t("nav.source")}
                    </a>
                </li>
            </ul>
        </nav>
        <p class="text-muted">{t("footer.local")}</p>
        <p class="text-muted">{t("footer.license")}</p>
    </div>
</footer>

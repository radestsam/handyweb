---
/*
 * The site footer, at the bottom of the sidebar (Sidebar.astro). It starts
 * with the promise of the site, marked with the same green dot as the privacy
 * badge of a tool page. Then come the site links, the credit, and the release
 * that this build is. The release links to its code on GitHub.
 */
import { localePath, type Locale } from "@handyweb/core";
import { useTranslations } from "../i18n/site";
import { RELEASE_TAG, REPOSITORY } from "../release";
import Ltr from "./Ltr.astro";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const links = [
    { href: localePath(locale, "/about"), label: t("nav.about") },
    { href: localePath(locale, "/privacy"), label: t("nav.privacy") },
    { href: localePath(locale, "/opensource"), label: t("nav.opensource") },
    { href: localePath(locale, "/contribute"), label: t("nav.contribute") },
    { href: REPOSITORY, label: t("nav.source") },
];
---

<footer class="sidebar-foot">
    <p class="sidebar-foot-promise">
        <span aria-hidden="true" class="sidebar-foot-dot"></span>
        <span>{t("footer.local")}</span>
    </p>
    <nav aria-label={t("nav.footer")}>
        <ul class="sidebar-foot-links">
            {links.map((link) => (
                <li>
                    <a href={link.href}>{link.label}</a>
                </li>
            ))}
        </ul>
    </nav>
    <div class="sidebar-foot-meta">
        <p data-credit>
            {t("footer.creditBefore")}
            <a href="https://hesamrad.com" class="sidebar-foot-credit">
                {t("footer.creditName")}
            </a>
        </p>
        <a
            href={`${REPOSITORY}/releases/tag/${RELEASE_TAG}`}
            class="sidebar-foot-release"
            aria-label={`${t("footer.release")} ${RELEASE_TAG}`}
        >
            <Ltr>{RELEASE_TAG}</Ltr>
        </a>
    </div>
</footer>

---
import { localePath, type Locale } from "@handyweb/core";
import { useTranslations } from "../i18n/site";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const links = [
    { href: localePath(locale, "/about"), label: t("nav.about") },
    { href: localePath(locale, "/privacy"), label: t("nav.privacy") },
    { href: localePath(locale, "/opensource"), label: t("nav.opensource") },
    { href: localePath(locale, "/contribute"), label: t("nav.contribute") },
    { href: "https://github.com/radestsam/handyweb", label: t("nav.source") },
];
---

<footer class="mt-16 border-t border-border sm:mt-24">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-safe py-8 text-sm sm:py-10 md:flex-row md:items-start md:justify-between">
        <div class="max-w-md text-muted">
            <p>{t("footer.local")}</p>
            <p class="mt-4" data-credit>
                {t("footer.creditBefore")}
                <a href="https://hesamrad.com" class="text-text">
                    {t("footer.creditName")}
                </a>
            </p>
        </div>
        <nav aria-label={t("nav.footer")}>
            <ul class="flex flex-wrap gap-x-5 gap-y-2">
                {links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="text-muted no-underline hover:text-text hover:underline"
                        >
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</footer>

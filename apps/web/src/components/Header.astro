---
/*
 * The header band. It sits above the page content, beside the sidebar on wide
 * screens. It holds the breadcrumbs, the language link, and the theme button.
 * Below lg it also holds the menu button and the logo, because the sidebar is
 * a closed drawer there. The breadcrumbs then move to a second row.
 */
import { localePath, type Locale } from "@handyweb/core";
import { useTranslations } from "../i18n/site";
import Breadcrumbs from "./Breadcrumbs.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

interface Props {
    locale: Locale;
    path: string;
    /** The breadcrumb trail after "Home". Leave it out on the home page. */
    breadcrumbs?: Array<{ label: string; path?: string }> | undefined;
}

const { locale, path, breadcrumbs } = Astro.props;
const t = useTranslations(locale);
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur supports-[backdrop-filter]:bg-bg/80">
    <div class="mx-auto flex min-h-18 max-w-6xl flex-wrap items-center gap-x-4 px-safe lg:flex-nowrap">
        <button
            type="button"
            data-sidebar-open
            aria-controls="tool-sidebar"
            class="-ms-2 hidden size-10 shrink-0 items-center justify-center rounded-full text-muted hover:bg-surface-2 hover:text-text md:inline-flex lg:hidden"
        >
            <Icon name="menu" class="size-5 rtl:-scale-x-100" />
            <span class="sr-only">{t("sidebar.open")}</span>
        </button>
        <a
            href={localePath(locale, "/")}
            class="inline-flex h-18 shrink-0 items-center gap-2.5 text-lg font-bold text-text no-underline lg:hidden"
        >
            <Logo />
            <span>{t("site.name")}</span>
        </a>
        {breadcrumbs && (
            <div class="order-last min-w-0 basis-full pb-3 lg:order-none lg:flex-1 lg:basis-auto lg:pb-0">
                <Breadcrumbs locale={locale} items={breadcrumbs} />
            </div>
        )}
        <div class="ms-auto flex shrink-0 items-center gap-1">
            <LanguageSwitcher locale={locale} path={path} />
            <ThemeToggle locale={locale} />
        </div>
    </div>
</header>

---
import { localePath, type Locale } from "@handyweb/core";
import { useTranslations } from "../i18n/site";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";
import Search from "./Search.astro";

interface Props {
    locale: Locale;
    path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const links = [
    { href: localePath(locale, "/tools"), label: t("nav.tools"), path: "/tools/" },
    { href: localePath(locale, "/about"), label: t("nav.about"), path: "/about/" },
    { href: localePath(locale, "/privacy"), label: t("nav.privacy"), path: "/privacy/" },
];
const current = path.endsWith("/") ? path : `${path}/`;
---

<header class="border-b border-border bg-surface">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <a
            href={localePath(locale, "/")}
            class="inline-flex items-center gap-2 font-bold text-text no-underline"
        >
            <Logo />
            <span>{t("site.name")}</span>
        </a>
        <nav aria-label={t("nav.main")} class="me-auto">
            <ul class="flex flex-wrap items-center gap-1">
                {links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            aria-current={current === link.path ? "page" : undefined}
                            class="rounded-md px-2 py-1 text-sm text-text no-underline hover:bg-surface-2 aria-[current=page]:font-semibold aria-[current=page]:text-primary-text"
                        >
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
        <div class="flex items-center gap-2">
            <Search locale={locale} />
            <LanguageSwitcher locale={locale} path={path} />
            <ThemeToggle locale={locale} />
        </div>
    </div>
</header>

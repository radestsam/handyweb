---
/*
 * States exactly where the input of a tool goes (plan section 5.3). It is
 * driven by the tool metadata, never by a generic "100% private" claim.
 */
import type { Locale, ToolDefinition } from "@handyweb/core";

interface Props {
    tool: ToolDefinition;
    locale: Locale;
}

const { tool, locale } = Astro.props;

const text = {
    local: {
        fa: "روی دستگاه خودتان کار می‌کند.",
        en: "Runs on your device.",
    },
    localDownload: {
        fa: "روی دستگاه خودتان کار می‌کند. یک بار برنامه بارگیری می‌شود.",
        en: "Runs on your device. A program downloads once.",
    },
    external: {
        fa: "این ابزار ورودی را پس از پذیرش شما به سرویس دیگری می‌فرستد.",
        en: "This tool sends your input to another service after you agree.",
    },
};

const kind =
    tool.privacy === "external-consent-required"
        ? "external"
        : tool.networkUse === "none"
          ? "local"
          : "localDownload";
const local = kind !== "external";
---

<p
    class:list={[
        "inline-flex max-w-full items-baseline gap-2 rounded-xl border px-3 py-1.5 text-sm sm:rounded-full",
        local ? "border-border bg-surface text-muted" : "border-error bg-error-bg text-error",
    ]}
    data-privacy={kind}
>
    <span
        aria-hidden="true"
        class:list={[
            "size-2 shrink-0 translate-y-[-0.1em] rounded-full",
            local
                ? "bg-success shadow-[0_0_0_3px_color-mix(in_oklab,var(--hw-success)_20%,transparent)]"
                : "bg-error",
        ]}
    ></span>
    <span>{text[kind][locale]}</span>
</p>

---
/* A text page: breadcrumbs, a title, and prose. */
import type { Locale } from "@handyweb/core";
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Props {
    locale: Locale;
    path: string;
    title: string;
    /** A unique meta description for this page. */
    description: string;
}

const { locale, path, title, description } = Astro.props;
---

<Base
    locale={locale}
    path={path}
    title={title.includes("HandyWeb") ? title : `${title} | HandyWeb`}
    description={description}
>
    <main id="main" class="mx-auto max-w-6xl px-safe pt-8 sm:pt-12">
        <Breadcrumbs locale={locale} items={[{ label: title }]} />
        <h1 class="mt-6 text-2xl font-bold">{title}</h1>
        <div class="prose-hw mt-8 max-w-[68ch]">
            <slot />
        </div>
    </main>
</Base>

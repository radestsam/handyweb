---
import "../styles/global.css";
import { DIRECTION, LANGUAGE_TAG, LOCALES, localePath, type Locale } from "@handyweb/core";
import Fonts from "../components/Fonts.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TabBar from "../components/TabBar.astro";
import Search from "../components/Search.astro";
import themeInit from "../scripts/theme-init.js?raw";
import { useTranslations } from "../i18n/site";

interface Props {
    locale: Locale;
    /** The locale-neutral path of the page, for example "/" or "/about". */
    path: string;
    title: string;
    description?: string | undefined;
    /** Structured data (schema.org) for this page. */
    jsonLd?: unknown[] | undefined;
}

const { locale, path, title, description, jsonLd = [] } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://handyweb.ir");
const canonical = new URL(localePath(locale, path), site).href;
const alternates = LOCALES.map((l) => ({
    hreflang: LANGUAGE_TAG[l],
    href: new URL(localePath(l, path), site).href,
}));
const xDefault = new URL(localePath("fa", path), site).href;
---

<!doctype html>
<html lang={locale} dir={DIRECTION[locale]}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0d1015" media="(prefers-color-scheme: dark)" />
        <title>{title}</title>
        <meta name="description" content={description ?? t("site.description")} />
        <link rel="canonical" href={canonical} />
        {alternates.map((a) => (
            <link rel="alternate" hreflang={a.hreflang} href={a.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefault} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="HandyWeb" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description ?? t("site.description")} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={locale === "fa" ? "fa_IR" : "en_US"} />
        <meta property="og:locale:alternate" content={locale === "fa" ? "en_US" : "fa_IR"} />
        <meta name="twitter:card" content="summary" />
        {jsonLd.map((data) => (
            <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
        ))}
        <meta name="color-scheme" content="light dark" />
        <script is:inline set:html={themeInit} />
        <Fonts lang={locale} />
    </head>
    <body class="flex min-h-dvh flex-col bg-bg text-text antialiased">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:start-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2"
        >
            {t("nav.skip")}
        </a>
        <Header locale={locale} path={path} />
        <div class="flex-1">
            <slot />
        </div>
        <Footer locale={locale} />
        <TabBar locale={locale} path={path} />
        <Search locale={locale} />
    </body>
</html>

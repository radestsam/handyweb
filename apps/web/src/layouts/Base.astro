---
import "../styles/global.css";
import Fonts from "../components/Fonts.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import themeInit from "../scripts/theme-init.js?raw";

interface Props {
    lang: "fa" | "en";
    title: string;
    description?: string;
}

const { lang, title, description } = Astro.props;
const dir = lang === "fa" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang} dir={dir}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <meta name="color-scheme" content="light dark" />
        <script is:inline set:html={themeInit} />
        <Fonts lang={lang} />
    </head>
    <body class="min-h-dvh bg-bg text-text antialiased">
        <ThemeToggle />
        <slot />
    </body>
</html>

---
import type { Locale } from "@handyweb/core";
import Page from "../../layouts/Page.astro";
import { useTranslations } from "../../i18n/site";
import { localeStaticPaths } from "../../i18n/static-paths";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const description =
    locale === "fa"
        ? "HandyWeb چیست و چرا ابزارهایش روی دستگاه خودتان کار می‌کنند: رایگان، بی‌نام‌نویسی، بی‌آگهی و متن‌باز."
        : "What HandyWeb is and why its tools run on your own device: free, no sign-up, no ads, and open source.";
---

<Page locale={locale} path="/about" title={t("about.title")} description={description}>
    {locale === "fa" ? (
        <>
            <p>
                HandyWeb مجموعه‌ای رایگان و متن‌باز از ابزارهای آنلاین است: ابزارهای متن، کدگذاری،
                رمزنگاری، برنامه‌نویسی، گاه‌شمار و ابزارهای ویژه زبان فارسی.
            </p>
            <h2>آنچه برای ما مهم است</h2>
            <ul>
                <li>رایگان و بدون نیاز به ساخت حساب کاربری</li>
                <li>بدون تبلیغات</li>
                <li>بدون نگهداری اطلاعات کاربر</li>
                <li>
                    همه کار روی دستگاه خودتان انجام می‌شود. ورودی ابزارها به هیچ سروری فرستاده
                    نمی‌شود.
                </li>
                <li>ساخته شده برای کاربرهای ایرانی که دسترسی به ابزارهای مشابه را ندارند</li>
                <li>
                    سرویس به صورت متن‌باز است و هر کسی می‌تواند کد آن را بخواند یا در بهتر شدنش به
                    ما کمک کند.
                </li>
            </ul>
        </>
    ) : (
        <>
            <p>
                HandyWeb is a free, open-source collection of useful web tools: text, encoding,
                cryptography, developer, date, and Persian-language tools.
            </p>
            <h2>Our Principles</h2>
            <ul>
                <li>Free, with no sign-up and no ads.</li>
                <li>Processing happens on your device. Tool input is never sent to a server.</li>
                <li>No analytics and no trackers.</li>
                <li>
                    Persian first: right-to-left layout, the Jalali calendar, and tools for Persian
                    text.
                </li>
                <li>The source code is open, so anyone can check it or make it better.</li>
            </ul>
        </>
    )}
</Page>

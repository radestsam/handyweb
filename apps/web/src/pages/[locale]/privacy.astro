---
/*
 * The privacy page must describe what the code and the hosts actually do
 * (plan section 9). Update it in the same pull request as any change to
 * storage, requests, or hosting. The hosting section is filled in at the
 * launch gate (T2.4).
 */
import type { Locale } from "@handyweb/core";
import Page from "../../layouts/Page.astro";
import Ltr from "../../components/Ltr.astro";
import { localeStaticPaths } from "../../i18n/static-paths";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const title = locale === "fa" ? "حریم خصوصی" : "Privacy";
const description =
    locale === "fa"
        ? "HandyWeb چه چیزی را نگه می‌دارد و چه چیزی را نه: بی‌کوکی، بی‌آمارگیر، و ورودی ابزارها هرگز از دستگاه شما بیرون نمی‌رود."
        : "What HandyWeb stores and what it does not: no cookies, no analytics, and tool input never leaves your device.";
---

<Page locale={locale} path="/privacy" title={title} description={description}>
    {locale === "fa" ? (
        <>
            <p>
                ابزارهای HandyWeb در مرورگر خودتان کار می‌کنند. نوشته، فایل و خروجی هر ابزار روی
                دستگاه شما می‌ماند و به سرور HandyWeb یا هیچ سرویس دیگری فرستاده نمی‌شود.
            </p>
            <h2>آنچه گردآوری نمی‌کنیم</h2>
            <ul>
                <li>سایت هیچ ابزار آمارگیری، ردیاب آگهی یا ضبط کار کاربران ندارد.</li>
                <li>سایت هیچ کوکی نمی‌گذارد.</li>
                <li>
                    ورودی‌ها و خروجی‌های ابزارها نگه داشته نمی‌شوند. با بستن برگه از میان می‌روند.
                </li>
                <li>
                    قلم‌ها و همه فایل‌های سایت از خود HandyWeb بارگیری می‌شوند، نه از سرویس دیگری.
                </li>
            </ul>
            <h2>آنچه مرورگر شما نگه می‌دارد</h2>
            <p>تنها این دو گزینه، و تنها هنگامی که خودتان یکی را برگزینید:</p>
            <table>
                <thead>
                    <tr>
                        <th>کلید</th>
                        <th>چه چیزی</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <Ltr as="code">handyweb:theme</Ltr>
                        </td>
                        <td>پوسته برگزیده: روشن یا تیره</td>
                    </tr>
                    <tr>
                        <td>
                            <Ltr as="code">handyweb:locale</Ltr>
                        </td>
                        <td>واپسین زبانی که برگزیده‌اید</td>
                    </tr>
                </tbody>
            </table>
            <p>
                برای پاک کردن آن‌ها، داده‌های سایت <Ltr>handyweb.ir</Ltr> را در گزینه‌های مرورگر پاک
                کنید.
            </p>
            <h2>میزبانی</h2>
            <p>
                مانند هر وب‌سایتی، میزبان سایت هنگام فرستادن برگه‌ها نشانی IP و زمان درخواست شما را
                می‌بیند. نام میزبان‌ها و پیوند به برگه حریم خصوصی آن‌ها پیش از راه‌اندازی همگانی در
                اینجا می‌آید.
            </p>
        </>
    ) : (
        <>
            <p>
                HandyWeb tools run in your own browser. The text, files, and results that you use in
                a tool stay on your device. They are not sent to a HandyWeb server or to any other
                service.
            </p>
            <h2>What We Do Not Collect</h2>
            <ul>
                <li>
                    The site has no analytics, no advertising trackers, and no session recording.
                </li>
                <li>The site sets no cookies.</li>
                <li>
                    Tool inputs and results are not stored. They are gone when you close the page.
                </li>
                <li>
                    Fonts and every other file load from HandyWeb itself, not from another service.
                </li>
            </ul>
            <h2>What Your Browser Stores</h2>
            <p>Only these two settings, and only when you change them:</p>
            <table>
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Content</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <Ltr as="code">handyweb:theme</Ltr>
                        </td>
                        <td>Your theme: light or dark</td>
                    </tr>
                    <tr>
                        <td>
                            <Ltr as="code">handyweb:locale</Ltr>
                        </td>
                        <td>The last language you chose</td>
                    </tr>
                </tbody>
            </table>
            <p>To remove them, clear the site data of handyweb.ir in your browser settings.</p>
            <h2>Hosting</h2>
            <p>
                Like every website, the hosting company receives connection data, such as your IP
                address and the time of the request, when it serves a page. The names of the hosting
                companies and links to their privacy policies will be listed here before the public
                launch.
            </p>
        </>
    )}
</Page>

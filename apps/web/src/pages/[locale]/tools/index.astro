---
import { localePath, nonEmptyCategories, toolsInCategory, type Locale } from "@handyweb/core";
import Page from "../../../layouts/Page.astro";
import { useTranslations } from "../../../i18n/site";
import { localeStaticPaths } from "../../../i18n/static-paths";
import { categories, tools } from "../../../i18n/tools";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const groups = nonEmptyCategories(categories, tools).map((category) => ({
    category,
    tools: toolsInCategory(tools, category.id),
}));
---

<Page locale={locale} path="/tools" title={t("nav.tools")}>
    {groups.map(({ category, tools }) => (
        <section>
            <h2>
                <a href={localePath(locale, `/categories/${category.slug}`)}>
                    {category.title[locale]}
                </a>
            </h2>
            <ul class="!list-none !ps-0" data-tool-list>
                {tools.map((tool) => (
                    <li>
                        <a href={localePath(locale, `/tools/${tool.slug}`)} class="font-semibold">
                            {tool.title[locale]}
                        </a>
                        <p class="text-sm text-muted">{tool.description[locale]}</p>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</Page>

---
import { localePath, type Locale, type ToolDefinition } from "@handyweb/core";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PrivacyBadge from "../../../components/tool/PrivacyBadge.astro";
import ToolIsland from "../../../components/tool/ToolIsland";
import { useTranslations } from "../../../i18n/site";
import { toolSourceUrl } from "../../../release";
import { categoryOf, toolStaticPaths } from "../../../i18n/tools";

export const getStaticPaths = toolStaticPaths;

interface Props {
    tool: ToolDefinition;
    alias: boolean;
}

const locale = Astro.params.locale as Locale;
const { tool, alias } = Astro.props;
const t = useTranslations(locale);
const category = categoryOf(tool);
const path = `/tools/${tool.slug}`;
const canonical = new URL(localePath(locale, path), Astro.site).href;
const heading = { fa: "محدودیت‌ها", en: "Limitations" }[locale];
const source = toolSourceUrl(tool.category, tool.id);
---

{alias ? (
    <html lang={locale}>
        <head>
            <meta charset="utf-8" />
            <title>{tool.title[locale]}</title>
            <meta http-equiv="refresh" content={`0; url=${localePath(locale, path)}`} />
            <meta name="robots" content="noindex" />
            <link rel="canonical" href={canonical} />
        </head>
        <body>
            <a href={localePath(locale, path)}>{tool.title[locale]}</a>
        </body>
    </html>
) : (
    <Base
        locale={locale}
        path={path}
        title={`${tool.title[locale]} | ${t("site.name")}`}
        description={tool.description[locale]}
    >
        <main id="main" class="mx-auto max-w-6xl px-5 pt-8 sm:px-8 sm:pt-12">
            <Breadcrumbs
                locale={locale}
                items={[
                    { label: t("nav.tools"), path: "/tools" },
                    ...(category
                        ? [{ label: category.title[locale], path: `/categories/${category.slug}` }]
                        : []),
                    { label: tool.title[locale] },
                ]}
            />
            <h1 class="mt-6 max-w-[32ch] text-2xl font-bold">{tool.title[locale]}</h1>
            <p class="mt-3 max-w-[60ch] text-muted">{tool.description[locale]}</p>
            <div class="mt-4">
                <PrivacyBadge tool={tool} locale={locale} />
            </div>

            <section
                class="mt-10 border-t border-border pt-8 sm:mt-12 sm:pt-10"
                data-tool-root={tool.id}
            >
                <ToolIsland
                    client:only="react"
                    toolId={tool.id}
                    locale={locale}
                    presets={tool.presets.map(({ id, options }) => ({ id, options }))}
                />
                <noscript>
                    <p class="text-sm">
                        {locale === "fa"
                            ? "این ابزار برای اجرا روی دستگاه شما به JavaScript نیاز دارد."
                            : "This tool needs JavaScript to run on your device."}
                    </p>
                </noscript>
            </section>

            {tool.limitations && (
                <section class="prose-hw mt-16 max-w-[60ch] border-t border-border pt-8">
                    <h2>{heading}</h2>
                    <p>{tool.limitations[locale]}</p>
                </section>
            )}

            <p class="mt-10 text-sm">
                <a href={source}>
                    {locale === "fa" ? "کد منبع این ابزار" : "Source code of this tool"}
                </a>
            </p>
        </main>
    </Base>
)}

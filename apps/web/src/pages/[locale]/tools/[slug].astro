---
import { localePath, type Locale, type ToolDefinition } from "@handyweb/core";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import PrivacyBadge from "../../../components/tool/PrivacyBadge.astro";
import Unbroken from "../../../components/Unbroken.astro";
import ToolIsland from "../../../components/tool/ToolIsland";
import { useTranslations } from "../../../i18n/site";
import { toolSourceUrl } from "../../../release";
import { categoryOf, toolStaticPaths, tools } from "../../../i18n/tools";

export const getStaticPaths = toolStaticPaths;

interface Props {
    tool: ToolDefinition;
    alias: boolean;
}

const locale = Astro.params.locale as Locale;
const { tool, alias } = Astro.props;
const t = useTranslations(locale);
const category = categoryOf(tool);
const path = `/tools/${tool.slug}`;
const canonical = new URL(localePath(locale, path), Astro.site).href;
const heading = { fa: "آنچه باید بدانید", en: "Good to Know" }[locale];
const source = toolSourceUrl(tool.category, tool.id);
const site = Astro.site ?? new URL("https://handyweb.ir");
const related = tool.related
    .map((id) => tools.find((other) => other.id === id))
    .filter((other): other is ToolDefinition => other !== undefined);
const relatedLabel = { fa: "ابزارهای نزدیک", en: "Related Tools" }[locale];
const url = (p: string) => new URL(localePath(locale, p), site).href;
const labels = {
    fa: { how: "چگونه به کار ببریم", faq: "پرسش‌های رایج" },
    en: { how: "How to Use It", faq: "Questions and Answers" },
}[locale];

// Structured data: the tool as a free web application, its questions, and its place in the site.
const jsonLd: unknown[] = [
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: tool.title[locale],
        description: tool.description[locale],
        url: url(path),
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Any",
        browserRequirements: "Requires JavaScript",
        inLanguage: locale === "fa" ? "fa-IR" : "en",
        isAccessibleForFree: true,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            { "@type": "ListItem", position: 1, name: t("nav.home"), item: url("/") },
            { "@type": "ListItem", position: 2, name: t("nav.tools"), item: url("/tools") },
            ...(category
                ? [
                      {
                          "@type": "ListItem",
                          position: 3,
                          name: category.title[locale],
                          item: url(`/categories/${category.slug}`),
                      },
                  ]
                : []),
            {
                "@type": "ListItem",
                position: category ? 4 : 3,
                name: tool.title[locale],
                item: url(path),
            },
        ],
    },
    ...(tool.guide && tool.guide.faq.length > 0
        ? [
              {
                  "@context": "https://schema.org",
                  "@type": "FAQPage",
                  mainEntity: tool.guide.faq.map((item) => ({
                      "@type": "Question",
                      name: item.question[locale],
                      acceptedAnswer: { "@type": "Answer", text: item.answer[locale] },
                  })),
              },
          ]
        : []),
];
---

{alias ? (
    <html lang={locale}>
        <head>
            <meta charset="utf-8" />
            <title>{tool.title[locale]}</title>
            <meta http-equiv="refresh" content={`0; url=${localePath(locale, path)}`} />
            <meta name="robots" content="noindex" />
            <link rel="canonical" href={canonical} />
        </head>
        <body>
            <a href={localePath(locale, path)}>{tool.title[locale]}</a>
        </body>
    </html>
) : (
    <Base
        locale={locale}
        path={path}
        title={`${tool.title[locale]} | ${t("site.name")}`}
        jsonLd={jsonLd}
        description={tool.description[locale]}
    >
        <main id="main" class="mx-auto max-w-6xl px-safe pt-5 sm:pt-12">
            <Breadcrumbs
                locale={locale}
                items={[
                    { label: t("nav.tools"), path: "/tools" },
                    ...(category
                        ? [{ label: category.title[locale], path: `/categories/${category.slug}` }]
                        : []),
                    { label: tool.title[locale] },
                ]}
            />
            <h1 class="mt-4 max-w-[32ch] text-xl font-bold sm:mt-6 sm:text-2xl">
                <Unbroken text={tool.title[locale]} />
            </h1>
            <p class="mt-2 max-w-[60ch] text-sm text-muted sm:mt-3 sm:text-base">
                {tool.description[locale]}
            </p>
            <div class="mt-4">
                <PrivacyBadge tool={tool} locale={locale} />
            </div>

            <section
                class="panel mt-6 -mx-5 rounded-none border-x-0 px-4 py-5 sm:mx-0 sm:mt-10 sm:rounded-[1.25rem] sm:border-x sm:p-8"
                data-tool-root={tool.id}
            >
                <ToolIsland
                    client:only="react"
                    toolId={tool.id}
                    locale={locale}
                    presets={tool.presets.map(({ id, options }) => ({ id, options }))}
                />
                <noscript>
                    <p class="text-sm">
                        {locale === "fa"
                            ? "این ابزار برای کار روی دستگاه شما به JavaScript نیاز دارد."
                            : "This tool needs JavaScript to run on your device."}
                    </p>
                </noscript>
            </section>

            {tool.guide && (
                <section
                    class="prose-hw mt-12 max-w-[60ch] border-t border-border pt-8 sm:mt-16"
                    aria-labelledby="how"
                >
                    <h2 id="how">{labels.how}</h2>
                    <ol class="steps">
                        {tool.guide.steps.map((step) => (
                            <li>{step[locale]}</li>
                        ))}
                    </ol>
                </section>
            )}

            {tool.guide && tool.guide.faq.length > 0 && (
                <section class="prose-hw mt-12 max-w-[60ch]" aria-labelledby="faq">
                    <h2 id="faq">{labels.faq}</h2>
                    {tool.guide.faq.map((item) => (
                        <details class="faq border-b border-border">
                            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold">
                                <span>{item.question[locale]}</span>
                                <svg
                                    aria-hidden="true"
                                    viewBox="0 0 24 24"
                                    class="size-4 shrink-0 text-muted transition-transform duration-200"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="m6 9 6 6 6-6" />
                                </svg>
                            </summary>
                            <p class="pb-4 text-muted">{item.answer[locale]}</p>
                        </details>
                    ))}
                </section>
            )}

            {tool.limitations && (
                <section class="prose-hw mt-12 max-w-[60ch]">
                    <h2>{heading}</h2>
                    <p>{tool.limitations[locale]}</p>
                </section>
            )}

            {related.length > 0 && (
                <section
                    class="mt-12 border-t border-border pt-8 sm:mt-16"
                    aria-labelledby="related"
                >
                    <h2 id="related" class="text-lg font-bold">
                        {relatedLabel}
                    </h2>
                    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
                        {related.map((item) => (
                            <li>
                                <a
                                    href={localePath(locale, `/tools/${item.slug}`)}
                                    class="flex min-h-12 flex-col justify-center rounded-xl bg-surface-2 px-4 py-3 text-text no-underline transition-colors hover:bg-border/50 active:bg-border/70"
                                >
                                    <span class="font-semibold">
                                        <Unbroken text={item.title[locale]} />
                                    </span>
                                    <span class="text-sm text-muted">
                                        {item.description[locale]}
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

            <p class="mt-10 text-sm">
                <a href={source}>
                    {locale === "fa" ? "کد این ابزار در GitHub" : "Source code of this tool"}
                </a>
            </p>
        </main>
    </Base>
)}

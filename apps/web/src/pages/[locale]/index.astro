---
import { localePath, nonEmptyCategories, toolsInCategory, type Locale } from "@handyweb/core";
import Base from "../../layouts/Base.astro";
import ToolList from "../../components/ToolList.astro";
import { useTranslations } from "../../i18n/site";
import { localeStaticPaths } from "../../i18n/static-paths";
import { categories, tools } from "../../i18n/tools";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const groups = nonEmptyCategories(categories, tools)
    .map((category) => ({
        category,
        // A tool appears once on the home page: under its own category.
        tools: toolsInCategory(tools, category.id).filter((tool) => tool.category === category.id),
    }))
    .filter((group) => group.tools.length > 0);

const text = {
    fa: {
        title: "ابزارهای آنلاین رایگان، روی دستگاه خودتان",
        lead: "کدگذاری، هش فایل، تبدیل تاریخ و یکسان‌سازی نوشته فارسی را در مرورگر خودتان انجام دهید. چیزی به سرور فرستاده نمی‌شود.",
        privacy: "چطور ورودی شما روی دستگاهتان می‌ماند",
    },
    en: {
        title: "Free online tools that run on your own device",
        lead: "Encode text, hash files, convert Persian dates, and clean up Persian text in your browser. Nothing is sent to a server.",
        privacy: "How your input stays on your device",
    },
}[locale];
---

<Base
    locale={locale}
    path="/"
    title={
        locale === "fa"
            ? "HandyWeb: ابزارهای آنلاین رایگان فارسی"
            : "HandyWeb: Free Online Tools That Run in Your Browser"
    }
    jsonLd={[
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: "HandyWeb",
            url: new URL(`/${locale}/`, Astro.site).href,
            inLanguage: locale === "fa" ? "fa-IR" : "en",
            description: t("site.description"),
        },
    ]}
>
    <main id="main" class="mx-auto max-w-6xl px-5 sm:px-8">
        <section class="pt-12 pb-12 sm:pt-20 sm:pb-16" aria-labelledby="hero-title">
            <h1 id="hero-title" class="max-w-[30ch] text-xl font-bold sm:text-2xl">
                {text.title}
            </h1>
            <p class="mt-3 max-w-[60ch] text-muted">{text.lead}</p>
        </section>

        <ToolList locale={locale} groups={groups} />

        <p class="mt-16 text-sm">
            <a href={localePath(locale, "/privacy")}>{text.privacy}</a>
        </p>
    </main>
</Base>

---
import { localePath, type Locale } from "@handyweb/core";
import Base from "../../layouts/Base.astro";
import { useTranslations } from "../../i18n/site";
import { localeStaticPaths } from "../../i18n/static-paths";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const promise =
    locale === "fa"
        ? {
              title: "ورودی شما روی دستگاه خودتان می‌ماند",
              body: "ابزارها در مرورگر شما اجرا می‌شوند. هیچ ورودی، فایل یا نتیجه‌ای به سرور ارسال یا ذخیره نمی‌شود.",
              more: "درباره حریم خصوصی",
          }
        : {
              title: "Your input stays on your device",
              body: "The tools run in your browser. No input, file, or result is sent to a server or stored.",
              more: "About privacy",
          };
---

<Base locale={locale} path="/" title={`${t("site.name")}: ${t("site.tagline")}`}>
    <main id="main" class="mx-auto max-w-5xl px-4 py-10">
        <h1 class="text-4xl font-bold">{t("site.name")}</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted">{t("site.tagline")}</p>

        <section
            class="mt-10 rounded-xl border border-border bg-surface p-6"
            aria-labelledby="promise"
        >
            <h2 id="promise" class="text-xl font-bold">
                {promise.title}
            </h2>
            <p class="mt-2 text-muted">{promise.body}</p>
            <a class="mt-3 inline-block" href={localePath(locale, "/privacy")}>
                {promise.more}
            </a>
        </section>
    </main>
</Base>

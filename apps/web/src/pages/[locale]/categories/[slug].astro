---
import {
    LOCALES,
    nonEmptyCategories,
    toolsInCategory,
    type Locale,
    type ToolCategory,
} from "@handyweb/core";
import Base from "../../../layouts/Base.astro";
import ToolList from "../../../components/ToolList.astro";
import { useTranslations } from "../../../i18n/site";
import { categories, tools } from "../../../i18n/tools";
import { breadcrumbList, collectionPage } from "../../../seo";

export function getStaticPaths() {
    return LOCALES.flatMap((locale) =>
        nonEmptyCategories(categories, tools).map((category) => ({
            params: { locale, slug: category.slug },
            props: { category },
        })),
    );
}

const locale = Astro.params.locale as Locale;
const { category } = Astro.props as { category: ToolCategory };
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://handyweb.ir");
const path = `/categories/${category.slug}`;
const jsonLd = [
    breadcrumbList(locale, site, [
        { name: t("nav.home"), path: "/" },
        { name: t("nav.tools"), path: "/tools" },
        { name: category.title[locale], path },
    ]),
    collectionPage(
        locale,
        site,
        { name: category.title[locale], description: category.description[locale], path },
        toolsInCategory(tools, category.id),
    ),
];
---

<Base
    locale={locale}
    path={`/categories/${category.slug}`}
    title={`${category.seoTitle[locale]} | HandyWeb`}
    jsonLd={jsonLd}
    description={category.description[locale]}
    breadcrumbs={[{ label: t("nav.tools"), path: "/tools" }, { label: category.title[locale] }]}
>
    <main id="main" class="mx-auto max-w-6xl px-safe pt-8 sm:pt-12">
        <h1 class="text-2xl font-bold">{category.title[locale]}</h1>
        <p class="mt-2 max-w-[60ch] text-muted">{category.description[locale]}</p>
        <div class="mt-10">
            <ToolList
                locale={locale}
                groups={[{ category, tools: toolsInCategory(tools, category.id) }]}
                headings={false}
            />
        </div>
    </main>
</Base>

---
import type { Locale } from "@handyweb/core";
import Page from "../../layouts/Page.astro";
import { localeStaticPaths } from "../../i18n/static-paths";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const title = locale === "fa" ? "همکاری" : "Contribute";
const repo = "https://github.com/radestsam/handyweb";
const description =
    locale === "fa"
        ? "به HandyWeb کمک کنید: گزارش نادرستی، پیشنهاد ابزار تازه، بهتر کردن برگردان‌ها یا نوشتن کد."
        : "Help improve HandyWeb: report a bug, suggest a new tool, improve a translation, or write code.";
---

<Page locale={locale} path="/contribute" title={title} description={description}>
    {locale === "fa" ? (
        <>
            <p>
                هر کمکی ارزشمند است: گزارش نادرستی‌ها، پیشنهاد ابزار تازه، بهتر کردن برگردان‌ها یا
                نوشتن کد.
            </p>
            <ul>
                <li>
                    برای گزارش یک نادرستی یا پیشنهاد، یک{" "}
                    <a href={`${repo}/issues`}>issue در GitHub</a> باز کنید.
                </li>
                <li>
                    برای افزودن ابزار، راهنمای CONTRIBUTING.md را در <a href={repo}>انبار کد</a>{" "}
                    بخوانید.
                </li>
                <li>
                    اگر رخنه‌ای در ایمنی سایت یافتید، آن را همگانی نکنید. راه گزارش آن در
                    SECURITY.md آمده است.
                </li>
            </ul>
        </>
    ) : (
        <>
            <p>
                Every kind of help counts: bug reports, ideas for new tools, better translations, or
                code.
            </p>
            <ul>
                <li>
                    To report a bug or suggest a tool, open an{" "}
                    <a href={`${repo}/issues`}>issue on GitHub</a>.
                </li>
                <li>
                    To add a tool, read CONTRIBUTING.md in the <a href={repo}>repository</a>.
                </li>
                <li>To report a security problem, do not post it in public. See SECURITY.md.</li>
            </ul>
        </>
    )}
</Page>

---
import type { Locale } from "@handyweb/core";
import Page from "../../layouts/Page.astro";
import { localeStaticPaths } from "../../i18n/static-paths";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const title = locale === "fa" ? "متن‌باز" : "Open Source";
const repo = "https://github.com/radestsam/handyweb";
const description =
    locale === "fa"
        ? "کد HandyWeb با پروانه Apache 2.0 در GitHub در دسترس است، همراه با فهرست بخش‌هایی که از دیگران به کار رفته است."
        : "The HandyWeb source code is on GitHub under the Apache 2.0 license, with the third-party parts it uses and their licenses.";
---

<Page locale={locale} path="/opensource" title={title} description={description}>
    {locale === "fa" ? (
        <>
            <p>
                کد HandyWeb با پروانه Apache 2.0 در دسترس همه است. می‌توانید آن را بخوانید، به کار
                ببرید، بهتر کنید و دوباره پخش کنید.
            </p>
            <p>
                انبار کد: <a href={repo}>github.com/radestsam/handyweb</a>
            </p>
            <h2>بخش‌هایی از دیگران</h2>
            <p>
                HandyWeb از قلم‌های Noto Sans و Estedad (هر دو با پروانه SIL Open Font License 1.1)
                و چند بسته نرم‌افزاری متن‌باز بهره می‌برد. فهرست همه آن‌ها در فایل
                THIRD_PARTY_NOTICES.md آمده است.
            </p>
        </>
    ) : (
        <>
            <p>
                The HandyWeb source code is published under the Apache 2.0 license. You can read it,
                run it, change it, and publish it again.
            </p>
            <p>
                Repository: <a href={repo}>github.com/radestsam/handyweb</a>
            </p>
            <h2>Third-Party Components</h2>
            <p>
                HandyWeb uses the Noto Sans and Estedad fonts (both under the SIL Open Font License
                1.1) and a few open-source libraries. The full list is in the THIRD_PARTY_NOTICES.md
                file of the repository.
            </p>
        </>
    )}
</Page>

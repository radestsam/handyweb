---
/*
 * The bare root (D4). Hosts that read public/_redirects answer with a 301 to
 * /fa/ before this page is served. Other hosts serve this page, which sends
 * the visitor on with a meta refresh. No script decides the language.
 */
import { useTranslations } from "../i18n/site";

const t = useTranslations("fa");
const target = "/fa/";
---

<!doctype html>
<html lang="fa" dir="rtl">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{t("redirect.title")}</title>
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <meta name="robots" content="noindex" />
        <link rel="canonical" href={new URL(target, Astro.site).href} />
    </head>
    <body>
        <a href={target}>{t("redirect.body")}</a>
    </body>
</html>
